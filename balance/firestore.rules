rules_version = '2';

// Security rules for Balance teams.
//
// Everything a team stores (day cards, posts, member names) is encrypted on
// the phone with a key that only exists in the invite, so the server holds
// ciphertext. These rules decide who may read and write it:
//   - only signed-in members of a team can read it,
//   - a team has at most 5 members,
//   - joining needs the secret join hash (in a document id), which only
//     someone holding the invite can compute,
//   - people can only write their own cards and posts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function isMember(teamId) {
      return signedIn() && request.auth.uid in get(teamPath(teamId)).data.memberUids;
    }

    function sealedOnly(extra) {
      return request.resource.data.keys().hasOnly(['iv', 'ct'].concat(extra))
        && request.resource.data.keys().hasAll(['iv', 'ct'].concat(extra))
        && request.resource.data.iv is string && request.resource.data.iv.size() == 16
        && request.resource.data.ct is string && request.resource.data.ct.size() < 4000;
    }

    match /teams/{teamId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Create a team with yourself as the only member.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberUids', 'joinHash', 'createdAt'])
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.joinHash is string
        && request.resource.data.joinHash.size() == 64
        && request.resource.data.createdAt is timestamp;

      // Join: add yourself, up to 5 members. The join proof is a document
      // whose id contains the join hash, which only someone holding the
      // invite can compute (see the "joins" rule below).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && exists(/databases/$(database)/documents/teams/$(teamId)/joins/$(resource.data.joinHash + '_' + request.auth.uid))
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.memberUids.size() <= 5
        && request.resource.data.joinHash == resource.data.joinHash
        && request.resource.data.createdAt == resource.data.createdAt;

      // Proof of holding the invite. The id must be "<joinHash>_<your uid>".
      // A write can not prove knowledge by a field value, because an update
      // merges with the stored fields, so the proof is carried in the path.
      match /joins/{joinId} {
        allow create: if signedIn()
          && joinId == get(teamPath(teamId)).data.joinHash + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
      }

      // Leave, or remove one person (for example a phone that was lost).
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
        && request.resource.data.joinHash == resource.data.joinHash
        && request.resource.data.createdAt == resource.data.createdAt;

      // Each member's own encrypted profile (name, join day, break).
      match /members/{uid} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId) && request.auth.uid == uid && sealedOnly([]);
        allow delete: if isMember(teamId);
      }

      // One encrypted card per person per day. The id is "<date>_<uid>".
      match /days/{cardId} {
        allow read: if isMember(teamId);
        allow create, update: if isMember(teamId)
          && sealedOnly(['date', 'uid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.date is string
          && cardId == request.resource.data.date + '_' + request.auth.uid;
      }

      // Encrypted posts: write your own, delete your own.
      match /posts/{postId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && sealedOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is timestamp;
        allow delete: if isMember(teamId) && resource.data.uid == request.auth.uid;
      }

      // Nudges. The id is "<date>_<from>_<to>", and a nudge can be created
      // but never changed, which limits it to one per person per day.
      match /nudges/{nudgeId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['date', 'from', 'to'])
          && request.resource.data.from == request.auth.uid
          && nudgeId == request.resource.data.date + '_' + request.auth.uid + '_' + request.resource.data.to;
      }
    }
  }
}
